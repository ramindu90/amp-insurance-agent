# Local run only — on Agent Manager these come from the console.
OPENAI_MODEL=gpt-4o-mini

# Option A: through the Agent Manager LLM proxy (values from the agent's
# Configure > LLM Configurations panel, "External" tab / Integration guide)
# LLM_PROVIDER_URL=
# LLM_PROVIDER_KEY=
# Option B: direct to OpenAI
OPENAI_API_KEY=sk-...

# MCP — either the AMP MCP proxy URL (header X-API-Key) ...
# INSURANCE_MCP_URL=https://<amp-gateway-host>/<context>/mcp
# INSURANCE_MCP_API_KEY=<proxy key>
# ... or straight at Devant (header api-key)
INSURANCE_MCP_URL=https://<devant-public-url-of-insurance-mcp-endpoint>
INSURANCE_MCP_API_KEY=<devant api key>
INSURANCE_MCP_API_KEY_HEADER=api-key
